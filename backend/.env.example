PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL (Requires PostgreSQL >= 14)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/garment_erp?schema=public"

# Database Individual Parameters
DB_USER=postgres
DB_HOST=localhost
DB_NAME=garment_erp
DB_PASSWORD=password
DB_PORT=5432

# JWT Authentication
JWT_SECRET="supersecret_jwt_key_for_development"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway (Test Credentials)
RAZORPAY_KEY_ID="rzp_test_samplekey123"
RAZORPAY_KEY_SECRET="sample_razorpay_secret_12345"
RAZORPAY_WEBHOOK_SECRET="sample_webhook_secret_12345"
